# -*- python -*- 

import math

PI = math.pi

P_ORDER = 1


<warpx>

 ##
 # Basic parameters
 ##
 Simulation = advection1d
 # one of debug, info, warning, error, critical, disabled
 Verbosity = debug

 <advection1d>
   Type = WxSolver
   Kind = comboSolver

   Time = [0.0, 0.01] # start, end times
   Output_files = 1 # no. of output files to write
   Dt = 0.0001 # initial dt to try
   Dimensions = 2
   #Gridname = 'test.msh'
   Gridname = 'square.msh'
   NumFields = 1
   
   # Check the partition
   <hyperbolic>
	Type = ApSubSolver
	Kind = dg2dscheme
	
	Equations = [advection]
	
	polynomialOrder = P_ORDER
	cfl = 1.0/((2.*(P_ORDER+1)-1))
	
	DataStructure = [0,dg,(P_ORDER+1)*(P_ORDER+2)/2]
	<InitialCondition>
		Type = WxFunction
		Kind = exprFunc
		
		XC = 0.0
		YC = 0.0
		pi = PI

       exprList = ["pulse"]

       progn = ["pulse = exp(-10.0*((x-XC)*(x-XC)))"]
       ##progn = ["pulse = 1.0"]
       ##progn = ["pulse = x"]
       ##progn = ["r = abs(x)",\
	   ##         "pulse = if(r>0.5,0.0,sin(2*pi*x))"]
		
	</InitialCondition>
	
	<advection>
		Type = WxHyperbolicEqn
		Kind = advectionEqn
		
		ux = 1.0
		##uy = 1.0
	</advection>
	
   </hyperbolic>
	
   <stepHyper>
      Type = WxSubSolverStep
      SubSolvers = [hyperbolic]
   </stepHyper>
   
   ##
   # Solver sequence
   ##
   <SolverSequence>
      Type = WxSolverSequence
      PerStep = [stepHyper]
   </SolverSequence>

 </advection1d>

</warpx>
