# -*- python -*- 
import math

GAMMA = 1.4
Pres = 1.
Dens = GAMMA
c0 = math.sqrt(GAMMA*Pres/Dens)

TRANSIT_TIME = 2./c0 # seconds
TEND = TRANSIT_TIME/2 # seconds

P_ORDER = 1

<warpx>

 ##
 # Basic parameters
 ##
 Simulation = ffstep
 # one of debug, info, warning, error, critical, disabled
 Verbosity = info

 <ffstep>
   Type = WxSolver
   Kind = comboSolver

   Time = [0.0, 1.0] # start, end times
   Output_files = 10 # no. of output files to write
   Dt = 0.01 # initial dt to try
   Dimensions = 2
   Gridname = 'grid2.msh'
   NumFields = 1
   
   # Check the partition
   <hyperbolic>
	Type = ApSubSolver
	Kind = nodalDG2d
	
	polynomialOrder = P_ORDER
	cfl = 1.0/((2.*(P_ORDER+1)-1))
	
	Equations = [euler]
	boundaryConditions = [Wall]
	#Limiter = [eulerLimit]
	
	## setup data structure, [fieldNumber,FieldName,number-of-nodes-per-element]
	DataStructure = [0,dg,5*(P_ORDER+1)*(P_ORDER+2)/2]
	
	<InitialCondition>
		Type = WxFunction
		Kind = exprFunc
		
		gm = GAMMA
		rho0 = Dens
		p0 = Pres
		pert = 1.0
		beta = 10.0

       # list of preiliminary expressions to execute
       progn = ["r2 = x^2 + y^2", \
                "rho = rho0*(10.0 + pert*exp(-beta*r2))", \
                "pr = p0*(10.0 + pert*exp(-beta*r2))"]

       exprList = [ "rho", \
					"0.0", \
					"0.0", \
					"0.0", \
					"pr/(gm-1.)"]
		
	</InitialCondition>
	
	<euler>
		Type = WxHyperbolicEqn
		Kind = eulerEqn
		
		gas_gamma = GAMMA
		# either Lax-Friedrichs = LF, Roe, Wave, HLL
		Numerical_Flux = HLL
	</euler>
	
   </hyperbolic>

	<Wall>
	  Type = ApSubSolver
	  Kind = eulerWallBC

	</Wall>

	<eulerLimit>
	  Type = ApSubSolver
	  Kind = eulerLimiterHW

	  gas_gamma = GAMMA
	  min_pressure = 1.
	  min_density = 1.

	  boundaryConditions = [Wall]
	</eulerLimit>

	
   <stepHyper>
      Type = WxSubSolverStep
      SubSolvers = [hyperbolic]
   </stepHyper>
   
   ##
   # Solver sequence
   ##
   <SolverSequence>
      Type = WxSolverSequence
      PerStep = [stepHyper]
   </SolverSequence>

 </ffstep>

</warpx>
