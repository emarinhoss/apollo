# -*- python -*- 

import math

PI = math.pi

P_ORDER = 1

<warpx>

 ##
 # Basic parameters
 ##
 Simulation = advection1d
 # one of debug, info, warning, error, critical, disabled
 Verbosity = debug

 <advection1d>
   Type = WxSolver
   Kind = comboSolver

   Time = [0.0, 0.1] # start, end times
   Output_files = 1 # write output file after every step
   Dt = 0.01 # initial dt to try
   Dimensions = 2
   Gridname = 'square_fine.msh'
   NumFields = 1
   
   # Check the partition
   <hyperbolic>
	Type = ApSubSolver
	Kind = dg2dscheme
	
	Equations = [euler]
	
	polynomialOrder = P_ORDER
	cfl = 1.0/((2.*(P_ORDER+1)-1))

	# Filter
	filterOrder = P_ORDER
	filterCutoff = 0.95
	
	# Field number, Field name, number of unknowns per element
	DataStructure = [0,dg,5*(P_ORDER+1)*(P_ORDER+2)/2]
	<InitialCondition>
		Type = WxFunction
		Kind = exprFunc
		
		xo = 5.
		yo = 0.
		beta = 5.
		gamma = 1.4
		uo = 1.
		vo = 0.

		pi = PI

       exprList = ["rho","rhou","rhov","0.0","en"]

       progn = ["r = sqrt((x-xo)*(x-xo)+(y-yo)*(y-yo))",\
       			"u = uo - beta*exp(1.-r*r)*(y-yo)/(2.*pi)",\
       			"v = vo + beta*exp(1.-r*r)*(x-xo)/(2.*pi)",\
       			"base = 1. - ( (gamma-1.)*beta*beta*exp(2.*(1.-r*r))/(16.*gamma*pi*pi) )",\
       			"rho = base^(1./(gamma-1.))",\
       			"p   = rho^gamma",\
       			"en = p/(gamma-1.) + 0.5*rho*(u*u + v*v)",\
       			"rhou = rho*u",\
       			"rhov = rho*v"]
		
	</InitialCondition>
	
	<euler>
		Type = WxHyperbolicEqn
		Kind = eulerEqn
		
		gas_gamma = 1.4
	</euler>
	
   </hyperbolic>
	
   <stepHyper>
      Type = WxSubSolverStep
      SubSolvers = [hyperbolic]
   </stepHyper>
   
   ##
   # Solver sequence
   ##
   <SolverSequence>
      Type = WxSolverSequence
      PerStep = [stepHyper]
   </SolverSequence>

 </advection1d>

</warpx>
