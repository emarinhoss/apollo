# -*- python -*- 

import math

PI = math.pi

P_ORDER = 1
TEND = 5.

<warpx>

 ##
 # Basic parameters
 ##
 Simulation = Explosion
 # one of debug, info, warning, error, critical, disabled
 Verbosity = info

 <Explosion>
   Type = WxSolver
   Kind = comboSolver

   Time = [0.0, TEND] # start, end times
   Output_files = 20 # write output file after every step
   Dt = 0.01 # initial dt to try
   Dimensions = 2
   Gridname = 'gridBox.msh'
   NumFields = 1
   
   # Check the partition
   <hyperbolic>
	Type = ApSubSolver
	Kind = nodalDG2d
	
	Equations = [euler]
	boundaryConditions = [allSides]
	Limiter = [eulerLimit]
	
	polynomialOrder = P_ORDER
	cfl = 1.0/((2.*(P_ORDER+1)-1))

	
	# Field number, Field name, number of unknowns per element
	DataStructure = [0,dg,5*(P_ORDER+1)*(P_ORDER+2)//2]
	<InitialCondition>
		Type = WxFunction
		Kind = exprFunc
		
		xo = 1.
		yo = 1.
		r0 = 0.4
		gamma = 1.4

		pi = PI

       exprList = ["rho","0.0","0.0","0.0","en"]

       progn = ["r = sqrt((x-xo)*(x-xo)+(y-yo)*(y-yo))",\
       			"rho = if(r>r0,0.125,1.0)",\
       			"p   = if(r>r0,0.1,1.0)",\
       			"en = p/(gamma-1.)"]
		
	</InitialCondition>
	
	<euler>
		Type = WxHyperbolicEqn
		Kind = eulerEqn
		
		gas_gamma = 1.4
	</euler>
	
   </hyperbolic>

   <allSides>
	  Type = ApSubSolver
	  Kind = eulerDirichletBC
	  #King = eulerZeroGradientBC

	  pressure = 0.1
	  density = 0.125
	  xvelocity = 0.
	  yvelocity = 0.
	  zvelocity = 0.
	  gas_gamma = 1.4

	</allSides>

	<eulerLimit>
	  Type = ApSubSolver
	  Kind = eulerLimiterHW

	  gas_gamma = 1.4
	  min_pressure = 1.e-2
	  min_density = 1.e-2

	  boundaryConditions = [allSides]
	</eulerLimit>
	
   <stepHyper>
      Type = WxSubSolverStep
      SubSolvers = [hyperbolic]
   </stepHyper>
   
   ##
   # Solver sequence
   ##
   <SolverSequence>
      Type = WxSolverSequence
      PerStep = [stepHyper]
   </SolverSequence>

 </Explosion>

</warpx>
