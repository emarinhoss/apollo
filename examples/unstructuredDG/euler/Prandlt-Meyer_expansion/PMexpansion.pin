# -*- python -*- 

import math

PI = math.pi
Mach = 2.
P_ORDER = 1

<warpx>

 ##
 # Basic parameters
 ##
 Simulation = Expansion
 # one of debug, info, warning, error, critical, disabled
 Verbosity = debug

 <Expansion>
   Type = WxSolver
   Kind = comboSolver

   Time = [0.0, 1.0] # start, end times
   Output_files = 1 # write output file after every step
   Dt = 0.01 # initial dt to try
   Dimensions = 2
   Gridname = 'grid.msh'
   NumFields = 1
   
   # Check the partition
   <hyperbolic>
	Type = ApSubSolver
	Kind = nodalDG2d
	
	Equations = [euler]
	boundaryConditions = [inflow,bottomWall,noGrad,topWall]
	Limiter = [eulerLimit]
	
	polynomialOrder = P_ORDER
	cfl = 1.0/((2.*(P_ORDER+1)-1))

	
	# Field number, Field name, number of unknowns per element
	DataStructure = [0,dg,5*(P_ORDER+1)*(P_ORDER+2)/2]
	<InitialCondition>
		Type = WxFunction
		Kind = exprFunc
		
		pres = 1.01e5
		rho = 1.23
		gamma = 1.4
		M = Mach

       exprList = ["dens","u","0.0","0.0","en"]

       progn = ["dens = rho",\
       			"a0=sqrt(gamma*pres/rho)",\
       			"u = if(x>5,0.0,M*a0)",\
       			"en = pres/(gamma-1.)+0.5*dens*u*u"]
		
	</InitialCondition>
	
	<euler>
		Type = WxHyperbolicEqn
		Kind = eulerEqn
		
		gas_gamma = 1.4

	</euler>
	
   </hyperbolic>

   <inflow>
	  Type = ApSubSolver
	  Kind = eulerInflowBC

	  Mach_number = Mach
	  Flow_angle = 0.
	  Pressure = 1.01e5
	  gas_gamma = 1.4
	  density = 1.23
	</inflow>

	<bottomWall>
	  Type = ApSubSolver
	  Kind = eulerWallBC

	</bottomWall>

	<noGrad>
	  Type = ApSubSolver
	  Kind = eulerZeroGradientBC

	</noGrad>

	<topWall>
	  Type = ApSubSolver
	  Kind = eulerWallBC

	</topWall>

	<eulerLimit>
	  Type = ApSubSolver
	  Kind = eulerLimiterHW

	  gas_gamma = 1.4
	  min_pressure = 1.e-2 
	  min_density = 1.e-2

	  boundaryConditions = [inflow,bottomWall,noGrad,topWall]
	</eulerLimit>
	
   <stepHyper>
      Type = WxSubSolverStep
      SubSolvers = [hyperbolic]
   </stepHyper>
   
   ##
   # Solver sequence
   ##
   <SolverSequence>
      Type = WxSolverSequence
      PerStep = [stepHyper]
   </SolverSequence>

 </Expansion>

</warpx>
