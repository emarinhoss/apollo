# -*- python -*- 

GAMMA = 2./3.
SP_ORDER = 1
PI = 3.141592654

<warpx>

 ##
 # Basic parameters
 ##
 Simulation = ffstep
 # one of debug, info, warning, error, critical, disabled
 Verbosity = debug

 <ffstep>
   Type = WxSolver
   Kind = comboSolver

   Time = [0.0, 0.1] # start, end times
   Output_files = 5 # no. of output files to write
   Dt = 0.001 # initial dt to try
   Dimensions = 2
   Gridname = 'ffstep.exo'
   NumFields = 1
   
   # Check the partition
   <hyperbolic>
	Type = ApSubSolver
	Kind = dg2dscheme
	
	spatialOrder = SP_ORDER
	
	Equations = [euler]
	
	// setup data structure, [fieldNumber,FieldName]
	DataStructure = [0,dg,(SP_ORDER+1)*(SP_ORDER+2)/2*5]
	
	<InitialCondition>
		Type = WxFunction
		Kind = exprFunc
		
		XC = 1.0
		YC = 0.5
		pic = PI

       exprList = ["pulse", \
					"0.0", \
					"0.0", \
					"0.0", \
					"energy"]

       progn = ["pulse = exp(-25.0*((x-XC)*(x-XC)+(y-YC)*(y-YC)))", \
				"energy = sin(2.*pic*x)*sin(2.*pic*y)"]
		
	</InitialCondition>
	
	<euler>
		Type = WxHyperbolicEqn
		Kind = eulerEqn
		
		gas_gamma = GAMMA
	</euler>
	
   </hyperbolic>
	
   <stepHyper>
      Type = WxSubSolverStep
      SubSolvers = [hyperbolic]
   </stepHyper>
   
   ##
   # Solver sequence
   ##
   <SolverSequence>
      Type = WxSolverSequence
      PerStep = [stepHyper]
   </SolverSequence>

 </ffstep>

</warpx>
