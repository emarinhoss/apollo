# -*- python -*- 
import math

GAMMA = 1.4
P_ORDER = 1
PI = math.pi
Mach = 3.
Pr = 5.

<warpx>

 ##
 # Basic parameters
 ##
 Simulation = ffstep
 # one of debug, info, warning, error, critical, disabled
 Verbosity = info

 <ffstep>
   Type = WxSolver
   Kind = comboSolver

   Time = [0.0, 5.0] # start, end times
   Output_files = 100 # no. of output files to write
   Dt = 0.01 # initial dt to try
   Dimensions = 2
   Gridname = 'grid4.msh'
   NumFields = 1
   
   # Check the partition
   <hyperbolic>
	Type = ApSubSolver
	Kind = nodalDG2d
	
	polynomialOrder = P_ORDER
	cfl = 1.0/((2.*(P_ORDER+1)-1))
	
	Equations = [euler]
	boundaryConditions = [inflow,bottomWall,topWall,noGrad]
	Limiter = [eulerLimit]
	
	## setup data structure, [fieldNumber,FieldName]
	DataStructure = [0,dg,5*(P_ORDER+1)*(P_ORDER+2)//2]
	
	<InitialCondition>
		Type = WxFunction
		Kind = exprFunc
		
		XC = 1.0
		YC = 0.5
		gm = GAMMA
		M = Mach
		pres = Pr

       exprList = [ "rho", \
					"rhou", \
					"rhov", \
					"rhow", \
					"energy"]

       progn = ["rho = gm", \
       			"a=sqrt(gm*pres/rho)",\
       			"rhou= rho*M*a",\
       			"rhov= 0.0",\
       			"rhow= 0.0",\
				"energy = pres/(gm-1.)+0.5*(rhou*rhou+rhov*rhov+rhow*rhow)/rho"]
		
	</InitialCondition>
	
	<euler>
		Type = WxHyperbolicEqn
		Kind = eulerEqn
		
		gas_gamma = GAMMA
		# either Lax-Friedrichs = LF or HLL
		Numerical_Flux = Roe
	</euler>
	
   </hyperbolic>

   <inflow>
	  Type = ApSubSolver
	  Kind = eulerInflowBC

	  Mach_number = Mach
	  Flow_angle = 0.
	  Pressure = Pr
	  gas_gamma = GAMMA
	  density = GAMMA
	</inflow>

	<bottomWall>
	  Type = ApSubSolver
	  Kind = eulerWallBC

	</bottomWall>

	<noGrad>
	  Type = ApSubSolver
	  Kind = eulerZeroGradientBC

	</noGrad>

	<topWall>
	  Type = ApSubSolver
	  Kind = eulerWallBC

	</topWall>

	<eulerLimit>
	  Type = ApSubSolver
	  Kind = eulerLimiterHW

	  gas_gamma = GAMMA
	  min_pressure = 1.e-2
	  min_density = 1.e-2

	  boundaryConditions = [inflow,bottomWall,topWall,noGrad]
	</eulerLimit>
	
   <stepHyper>
      Type = WxSubSolverStep
      SubSolvers = [hyperbolic]
   </stepHyper>
   
   ##
   # Solver sequence
   ##
   <SolverSequence>
      Type = WxSolverSequence
      PerStep = [stepHyper]
   </SolverSequence>

 </ffstep>

</warpx>
