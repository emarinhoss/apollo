##
# Find HDF5 library
##



Import('warpMConstructionEnv')


#Add specified library paths to search paths for libs and headers
if warpMConstructionEnv['hdf5_base'] == '':
	warpMConstructionEnv['hdf5_base']  = warpMConstructionEnv['RESEARCH_SOFTWARE_BASE'] + '/hdf5mpi'
	
if warpMConstructionEnv['hdf5_base'] != '':
	#add base directory to path
	warpMConstructionEnv.AppendUnique(LIBPATH=(warpMConstructionEnv['hdf5_base']+'/lib'))
	warpMConstructionEnv.AppendUnique(CPPPATH=(warpMConstructionEnv['hdf5_base']+'/include'))


#configure libraries using some autoconf like functionality of scons
conf = Configure(warpMConstructionEnv)

try:
	assert(conf.CheckLibWithHeader('hdf5', 'hdf5.h', 'C'))
except:
	print 'HDF5 library or header hdf5.h not found'
	raise

try:
	assert(conf.CheckLib('z'))

except:
	print 'z lib library not found'
	raise

if ( warpMConstructionEnv['szip_base'] != ''  ): #take this as a sign that we should link to szip
	conf.env.AppendUnique(LIBPATH=(warpMConstructionEnv['szip_base']+'/lib'))
	try:
        	assert(conf.CheckLib('sz'))

	except:
		print 'szip lib library not found'
		raise

warpMConstructionEnv = conf.Finish() # replace the environment with the one modified by Configure's auto-conf actions
