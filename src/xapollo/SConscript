## -*- python -*-


Import('env')# objs')
##
# Build the Apollo executable
##

# source files in lib
sources = [
    'xapollo.cc',
    'apsimulation.cc',
    'apversion.cc',
           ]

##
# compile sources and add them to list of objects built
##
objs = []
for s in sources:
    o = env.Object(s)
    objs.append(o)

Return('objs')
